{
  "name": "todo-app",
  "productName": "TodoApp",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "web": "node service/web.js",
    "db-service": "node service/local-db-service.js",
    "smoke": "electron . --smoke-test",
    "smoke:ci": "electron . --smoke-test --no-sandbox",
    "smoke:renderer": "electron . --renderer-smoke-test --no-sandbox",
    "smoke:http": "electron . --http-renderer-smoke-test --no-sandbox",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "electron": "43.4.1"
  }
}
